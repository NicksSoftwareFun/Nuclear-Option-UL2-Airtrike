<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>UL2Airtrike</AssemblyName>
    <RootNamespace>UL2Airtrike</RootNamespace>
    <Version>0.4.0</Version>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <NobpFile Condition="'$(NobpFile)' == ''">UL-2 Airtrike_0.4.0.nobp</NobpFile>
    <NobpResourceName Condition="'$(NobpResourceName)' == ''">UL2Airtrike.UL-2 Airtrike_0.4.0.nobp</NobpResourceName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(NobpFile)" Condition="Exists('$(NobpFile)')">
      <LogicalName>$(NobpResourceName)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="lib\BepInEx.dll" Private="false" />
    <Reference Include="lib\0Harmony.dll" Private="false" />
    <Reference Include="lib\UnityEngine.dll" Private="false" />
    <Reference Include="lib\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="lib\netstandard.dll" Private="false" />
  </ItemGroup>
  <Target Name="WarnNoBundle" BeforeTargets="Build" Condition="!Exists('$(NobpFile)')">
    <Warning Text="No bundle $(NobpFile): the DLL would ship empty" />
  </Target>
</Project>
